{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pioneer-appointment-system",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 1000 },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pioneer-appointments",
    "database_id": "f607819a-83a6-4217-8618-5d4fd18e8bac",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "pioneer-attachments" }],
  "env": {
    "preview": {
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pioneer-appointments-preview",
        "database_id": "4e30f54b-564e-4801-87e0-ea3a7a85d510",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "pioneer-attachments-preview" }]
    }
  }
}
