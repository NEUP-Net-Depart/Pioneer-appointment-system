{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pioneer-appointment-system",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "vars": {
    "MAX_R2_BYTES": "8589934592",
    "TELEMETRY_ENABLED": "true",
    "TELEMETRY_INTERACTIONS": "true",
    "TELEMETRY_ENVIRONMENT": "production",
    "TELEMETRY_SAMPLE_RATE": "1",
    "TELEMETRY_POLL_SAMPLE_RATE": "1",
    "OBSERVABILITY_LOGS": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pioneer-appointments-production-v2",
      "database_id": "dd501f89-b431-462f-b9ec-403c25a27895",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "pioneer-attachments-production-v2"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "MAX_R2_BYTES": "536870912",
        "TELEMETRY_ENABLED": "false",
        "TELEMETRY_INTERACTIONS": "true",
        "TELEMETRY_ENVIRONMENT": "preview",
        "TELEMETRY_SAMPLE_RATE": "1",
        "TELEMETRY_POLL_SAMPLE_RATE": "1",
        "OBSERVABILITY_LOGS": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pioneer-appointments-preview-v2",
          "database_id": "aa6fc47a-3677-4888-b104-bf6e2eee6a20",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "pioneer-attachments-preview-v2"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "pioneer_telemetry_preview"
        }
      ]
    }
  },
  "upload_source_maps": true,
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "pioneer_telemetry_production"
    }
  ]
}
