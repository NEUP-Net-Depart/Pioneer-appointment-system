# Copy to backend/.env or export these variables in systemd/PM2.
NODE_ENV=production
PORT=8000
HOST=127.0.0.1
JWT_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
BOOTSTRAP_PASSWORD=replace-before-first-production-start
FRONTEND_ORIGIN=https://repair.example.edu.cn
# Optional persistent location outside the release directory.
DB_FILE=/var/lib/pioneer-repair/repair.sqlite
ATTACHMENTS_DIR=/var/lib/pioneer-repair/attachments
