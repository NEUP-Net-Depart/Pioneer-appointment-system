[Unit]
Description=Pioneer hardware repair booking API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pioneer-repair-booking
EnvironmentFile=/opt/pioneer-repair-booking/backend/.env
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/node /opt/pioneer-repair-booking/backend/server.js
Restart=always
RestartSec=5
User=pioneer-repair
Group=pioneer-repair
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pioneer-repair

[Install]
WantedBy=multi-user.target
