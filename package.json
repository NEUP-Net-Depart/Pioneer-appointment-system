{
  "name": "pioneer-appointment-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages with isolated Production and Preview resources",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "setup:local": "node scripts/setup-local.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/migrate-remote.ts",
    "db:seed": "node scripts/seed.ts",
    "attachments:cleanup": "node scripts/cleanup-attachments.ts",
    "appointments:expire": "node scripts/expire-appointments.ts",
    "check": "node scripts/check.ts",
    "test": "node --test tests/*.test.ts",
    "deploy": "node scripts/deploy.ts",
    "deploy:preview": "node scripts/deploy.ts --preview",
    "smoke": "node scripts/smoke.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings 0",
    "audit:architecture": "node scripts/audit.ts",
    "db:verify": "node scripts/verify-migrations.ts",
    "verify": "npm run verify:checks && npm run test:e2e",
    "verify:checks": "npm run format:staff:check && npm run lint && npm run typecheck && npm run telemetry:check && npm run db:history && npm run check && npm run build && npm test",
    "test:e2e": "node scripts/test-e2e.ts",
    "preview:local": "node scripts/test-e2e.ts --serve",
    "release:plan": "node scripts/release-plan.ts",
    "typecheck": "tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "format:staff": "prettier --write \"frontend/staff-react/**/*.{ts,tsx,css}\" \"src/{services,db}/staff-platform{.ts,/**/*.ts}\"",
    "format:staff:check": "prettier --check \"frontend/staff-react/**/*.{ts,tsx,css}\" \"src/{services,db}/staff-platform{.ts,/**/*.ts}\"",
    "db:history": "node scripts/verify-migration-history.ts",
    "telemetry:catalog": "node scripts/telemetry-catalog.ts",
    "telemetry:check": "node scripts/telemetry-catalog.ts --check",
    "telemetry:query": "node scripts/telemetry-query.ts",
    "test:migrations": "node --test tests/migrations/*.test.ts && npm run db:verify",
    "test:deployment": "npm run build && node --test tests/tools/deployment/*.test.ts",
    "test:e2e:full": "node scripts/test-e2e.ts --full",
    "test:e2e:diagnostics": "node scripts/test-e2e.ts --diagnostics",
    "test:sql": "node --test tests/tools/sql-performance.test.ts",
    "test:models:node": "node scripts/test-models.ts node",
    "test:models:e2e": "node scripts/test-models.ts e2e",
    "test:models": "node scripts/test-models.ts all",
    "test:models:check": "node --test tests/tools/model-report.test.ts",
    "test:properties": "node scripts/test-models.ts properties"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/eslint-parser": "8.1.2",
    "@cloudflare/workers-types": "5.20261006.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@plugin-web-update-notification/vite": "2.1.3",
    "@posthog/cli": "0.20.0",
    "@types/blueimp-load-image": "5.16.6",
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "4.149.0",
    "xstate": "6.0.0-beta.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tesseract.js-data/eng": "1.0.0",
    "blueimp-load-image": "5.16.0",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "posthog-js": "1.447.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "signature_pad": "5.1.4",
    "tesseract.js": "7.0.0",
    "zxing-wasm": "3.1.5"
  }
}
