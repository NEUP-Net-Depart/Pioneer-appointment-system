{
  "name": "pioneer-appointment-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages with isolated Production, Preview and Staff Staging resources",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "db:seed": "node scripts/seed.mjs",
    "attachments:cleanup": "node scripts/cleanup-attachments.mjs",
    "appointments:expire": "node scripts/expire-appointments.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "deploy:staff-staging": "node scripts/deploy.mjs --staff-staging",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint . --max-warnings 0",
    "audit:architecture": "node scripts/audit.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "verify": "npm run lint && npm run audit:architecture && npm run check && npm test && npm run db:verify && npm run test:e2e",
    "test:e2e": "node scripts/test-e2e.mjs",
    "preview:local": "node scripts/test-e2e.mjs --serve",
    "preview:booking-layout": "npm run build && node scripts/preview-booking-layout.mjs",
    "test:booking-layout": "npm run build && node --test tests/preview/booking-layout.test.mjs",
    "release:plan": "node scripts/release-plan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "blueimp-load-image": "5.16.0",
    "zxing-wasm": "3.1.5"
  }
}
