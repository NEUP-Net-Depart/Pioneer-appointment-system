{
  "name": "pioneer-appointment-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages with isolated Production and Preview resources",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "db:seed": "node scripts/seed.mjs",
    "attachments:cleanup": "node scripts/cleanup-attachments.mjs",
    "appointments:expire": "node scripts/expire-appointments.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test tests/*.test.mjs tests/architecture/*.test.mjs tests/extension/meeting-fixture/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint . --max-warnings 0",
    "audit:architecture": "node scripts/audit.mjs",
    "audit:staff-platform": "node scripts/audit-staff-platform.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "verify": "npm run format:staff:check && npm run lint && npm run typecheck && npm run audit:architecture && npm run audit:staff-platform && npm run check && npm test && npm run db:verify && npm run test:e2e && npm run test:field && npm run test:layout",
    "test:e2e": "node scripts/test-e2e.mjs",
    "preview:local": "node scripts/test-e2e.mjs --serve",
    "preview:booking-layout": "npm run build && node scripts/preview-booking-layout.mjs",
    "test:booking-layout": "npm run build && node --test tests/preview/booking-layout.test.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "typecheck": "tsc --noEmit",
    "test:field": "node scripts/test-e2e.mjs --field tests/e2e/field-flow.spec.mjs tests/e2e/reception-dispatch.spec.mjs tests/e2e/roster-flow.spec.mjs tests/e2e/staff-duty-updates.spec.mjs",
    "preview:field": "node scripts/test-e2e.mjs --serve --field",
    "format:staff": "prettier --write \"frontend/staff-react/**/*.{js,jsx,ts,tsx,css}\" \"src/{services,db}/staff-platform{.js,/**/*.js}\"",
    "format:staff:check": "prettier --check \"frontend/staff-react/**/*.{js,jsx,ts,tsx,css}\" \"src/{services,db}/staff-platform{.js,/**/*.js}\"",
    "test:mobile": "node scripts/mobile-audit.mjs",
    "test:layout": "node scripts/test-e2e.mjs --field --config tests/layout/playwright.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "blueimp-load-image": "5.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zxing-wasm": "3.1.5"
  }
}
