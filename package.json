{
  "name": "pioneer-appointment-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages with isolated Production and Preview resources",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "db:seed": "node scripts/seed.mjs",
    "attachments:cleanup": "node scripts/cleanup-attachments.mjs",
    "appointments:expire": "node scripts/expire-appointments.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint . --max-warnings 0",
    "audit:architecture": "node scripts/audit.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "verify": "npm run verify:checks && npm run test:e2e",
    "verify:checks": "npm run format:staff:check && npm run lint && npm run typecheck && npm run telemetry:check && npm run audit:architecture && npm run db:history && npm run check && npm test && npm run db:verify",
    "test:e2e": "node scripts/test-e2e.mjs",
    "preview:local": "node scripts/test-e2e.mjs --serve",
    "release:plan": "node scripts/release-plan.mjs",
    "typecheck": "tsc --noEmit",
    "format:staff": "prettier --write \"frontend/staff-react/**/*.{js,jsx,ts,tsx,css}\" \"src/{services,db}/staff-platform{.js,/**/*.js}\"",
    "format:staff:check": "prettier --check \"frontend/staff-react/**/*.{js,jsx,ts,tsx,css}\" \"src/{services,db}/staff-platform{.js,/**/*.js}\"",
    "db:history": "node scripts/verify-migration-history.mjs",
    "telemetry:catalog": "node scripts/telemetry-catalog.mjs",
    "telemetry:check": "node scripts/telemetry-catalog.mjs --check",
    "telemetry:query": "node scripts/telemetry-query.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@plugin-web-update-notification/vite": "2.1.3",
    "@posthog/cli": "0.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tesseract.js-data/eng": "1.0.0",
    "blueimp-load-image": "5.16.0",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "posthog-js": "1.447.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "7.0.0",
    "zxing-wasm": "3.1.5"
  }
}
