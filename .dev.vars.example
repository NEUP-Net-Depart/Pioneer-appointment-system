# npm run setup:local generates random local secrets and root passwords.
# Required Pages runtime secrets (no fallback):
JWT_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
# Optional stable QR signing secret (32+ characters). If unset, uses the PII key
# with a separate HMAC domain. Keep it stable: rotation invalidates printed codes.
# SCAN_QR_SECRET=replace-with-a-stable-random-secret
# Used ONLY by the local seed script, never by an HTTP endpoint:
ROOT001_PASSWORD=replace-with-a-strong-unique-password
ROOT002_PASSWORD=replace-with-another-strong-password
